# 依赖和编译缓存
node_modules/
__pycache__/
*.pyc

# 本地库和日志。聊天记录在 ~/.dsh/consciousness/，不进仓库。
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# 密钥和本机配置
.env
.env.*
credentials.json
*.pem

# 历史副本。版本记录由 git 管，这些文件不再入库。
*.bak
*.bak-*
src.bak-*/
_stray-scripts-file.bak
*.corrupted-*

# 一次性临时脚本：不校验、不入库
_tmp_*

# 一次性审计输出和测试日志
_audit/
_baseline/
run-tests*.txt

# 根目录的一次性草稿：调完就扔的东西，别再进版本库
# （已经 tracked 的旧文件不在此列，那是历史，逐步清）
_*.mjs
_*.out
_*.ps1
_*.md
_*.json
_*.log
_bak_*/

# 工作目录约定（2026-11-08）：
#   scratch/  一次性的探针脚本、临时笔记
#   var/      运行产物：导出、回放、统计
# 两者都不入库；根目录只留入口与源码。
scratch/
var/

# 微信自动化日志
wechatauto_logs/

# 系统杂项
.DS_Store
Thumbs.db
desktop.ini
